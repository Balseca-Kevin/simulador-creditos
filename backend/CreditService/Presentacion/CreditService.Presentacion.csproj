<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>CreditService.Presentacion</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- No referencia Estructura: los controladores no conocen la base de datos. -->
    <ProjectReference Include="..\Aplicacion\CreditService.Aplicacion.csproj" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- El SDK web importa estos espacios de nombres por omision; una
         biblioteca de clases no, asi que se declaran aqui. -->
    <Using Include="Microsoft.AspNetCore.Http" />
    <Using Include="Microsoft.AspNetCore.Mvc" />
  </ItemGroup>

</Project>
