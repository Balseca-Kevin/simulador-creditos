# Peticiones de prueba de la Credit API.
# Se ejecutan desde VS Code con la extensión "REST Client".
# Requiere la Auth API en marcha: el token se obtiene de ella.

@auth = http://localhost:5080
@credit = http://localhost:5090

### 1. Obtener un token de la Auth API
# @name login
POST {{auth}}/api/auth/login
Content-Type: application/json

{
  "email": "prueba@uta.edu.ec",
  "password": "Simulador2026"
}

### 2. Catálogo de tipos de crédito y sus tasas
GET {{credit}}/api/creditos/tipos
Authorization: Bearer {{login.response.body.token}}

### 3. Simular: Crédito de Consumo, 10 000 a 12 meses
POST {{credit}}/api/creditos/simular
Authorization: Bearer {{login.response.body.token}}
Content-Type: application/json

{
  "tipoCreditoId": 1,
  "monto": 10000,
  "plazoMeses": 12
}

### 4. Historial del usuario autenticado
GET {{credit}}/api/creditos/historial
Authorization: Bearer {{login.response.body.token}}

### 5. Sin token: debe responder 401
GET {{credit}}/api/creditos/tipos
